@model ShopIndexViewModel
@using System.Globalization
@{
    var q = Model.Query;
    var selectedCategory = Model.Categories.FirstOrDefault(c => c.Id == q.CategoryId);
    var selectedBrand = Model.Brands.FirstOrDefault(b => b.Id == q.BrandId);
    var title = selectedCategory?.Name ?? "Tüm ürünler";
    ViewData["Title"] = title;

    var hasFilters = !string.IsNullOrWhiteSpace(q.Search) || q.CategoryId.HasValue || q.BrandId.HasValue
                     || q.MinPrice.HasValue || q.MaxPrice.HasValue || q.InStockOnly;

    var page = Model.Products.Page < 1 ? 1 : Model.Products.Page;
    var totalPages = Model.Products.PageSize > 0 ? Model.Products.TotalPages : 0;
    var firstPage = Math.Max(1, page - 2);
    var lastPage = Math.Min(totalPages, page + 2);
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana sayfa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ürünler</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <h1 class="h2 mb-0">@title <span class="text-secondary fs-6 fw-normal">@Model.Products.TotalCount ürün</span></h1>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-light d-lg-none" data-bs-toggle="collapse" data-bs-target="#filters" aria-expanded="false" aria-controls="filters"><i class="bi bi-sliders me-1"></i>Filtreler</button>
            @* form="filters": select formun dışında ama onunla birlikte gönderilir *@
            <select class="form-select" name="sort" form="filters" aria-label="Sırala" onchange="this.form.requestSubmit()">
                <option value="Newest" selected="@(q.Sort == ProductSort.Newest)">En yeni</option>
                <option value="PriceAsc" selected="@(q.Sort == ProductSort.PriceAsc)">Fiyat: düşükten yükseğe</option>
                <option value="PriceDesc" selected="@(q.Sort == ProductSort.PriceDesc)">Fiyat: yüksekten düşüğe</option>
                <option value="NameAsc" selected="@(q.Sort == ProductSort.NameAsc)">İsim: A–Z</option>
            </select>
        </div>
    </div>

    @if (hasFilters)
    {
        @* Her etiket, o filtre kaldırılmış haliyle aynı sayfaya link *@
        <div class="d-flex flex-wrap gap-2 mb-4">
            @if (!string.IsNullOrWhiteSpace(q.Search))
            {
                <a class="lh-chip" asp-action="Index" asp-all-route-data="@((q with { Search = null, Page = 1 }).ToRouteValues())">"@q.Search" <i class="bi bi-x"></i></a>
            }
            @if (selectedCategory is not null)
            {
                <a class="lh-chip" asp-action="Index" asp-all-route-data="@((q with { CategoryId = null, Page = 1 }).ToRouteValues())">@selectedCategory.Name <i class="bi bi-x"></i></a>
            }
            @if (selectedBrand is not null)
            {
                <a class="lh-chip" asp-action="Index" asp-all-route-data="@((q with { BrandId = null, Page = 1 }).ToRouteValues())"><span lang="en">@selectedBrand.Name</span> <i class="bi bi-x"></i></a>
            }
            @if (q.MinPrice.HasValue || q.MaxPrice.HasValue)
            {
                <a class="lh-chip" asp-action="Index" asp-all-route-data="@((q with { MinPrice = null, MaxPrice = null, Page = 1 }).ToRouteValues())">
                    @(q.MinPrice.HasValue ? ProductDisplay.Price(q.MinPrice.Value) : "0 ₺") – @(q.MaxPrice.HasValue ? ProductDisplay.Price(q.MaxPrice.Value) : "…")
                    <i class="bi bi-x"></i>
                </a>
            }
            @if (q.InStockOnly)
            {
                <a class="lh-chip" asp-action="Index" asp-all-route-data="@((q with { InStockOnly = false, Page = 1 }).ToRouteValues())">Sadece stoktakiler <i class="bi bi-x"></i></a>
            }
            <a class="small text-secondary align-self-center ms-1" asp-action="Index">Tümünü temizle</a>
        </div>
    }

    <div class="row g-4">
        <aside class="col-lg-3">
            <form id="filters" class="collapse d-lg-block lh-surface p-3" method="get" asp-action="Index">
                <div class="d-grid gap-4">
                    <div>
                        <label class="form-label small fw-semibold" for="f-search">Arama</label>
                        <input id="f-search" name="search" value="@q.Search" class="form-control" placeholder="ör. superlight">
                    </div>

                    <fieldset>
                        <legend class="small fw-semibold mb-2 fs-6">Kategori</legend>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="categoryId" id="c-all" value="" checked="@(!q.CategoryId.HasValue)">
                            <label class="form-check-label" for="c-all">Tümü</label>
                        </div>
                        @foreach (var category in Model.Categories)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryId" id="c-@category.Id" value="@category.Id" checked="@(q.CategoryId == category.Id)">
                                <label class="form-check-label" for="c-@category.Id">@category.Name</label>
                            </div>
                        }
                    </fieldset>

                    <div>
                        <label class="form-label small fw-semibold" for="f-brand">Marka</label>
                        <select id="f-brand" name="brandId" class="form-select">
                            <option value="">Tüm markalar</option>
                            @foreach (var brand in Model.Brands)
                            {
                                <option value="@brand.Id" selected="@(q.BrandId == brand.Id)">@brand.Name</option>
                            }
                        </select>
                    </div>

                    <fieldset>
                        <legend class="small fw-semibold mb-2 fs-6">Fiyat aralığı (₺)</legend>
                        <div class="d-flex gap-2">
                            @* type="number" noktalı ondalık bekler: değerler InvariantCulture ile yazılır *@
                            <input name="minPrice" type="number" min="0" step="0.01" class="form-control" placeholder="En az" aria-label="En düşük fiyat" value="@q.MinPrice?.ToString(CultureInfo.InvariantCulture)">
                            <input name="maxPrice" type="number" min="0" step="0.01" class="form-control" placeholder="En çok" aria-label="En yüksek fiyat" value="@q.MaxPrice?.ToString(CultureInfo.InvariantCulture)">
                        </div>
                    </fieldset>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="f-stock" name="inStockOnly" value="true" checked="@q.InStockOnly">
                        <label class="form-check-label" for="f-stock">Sadece stoktakiler</label>
                    </div>

                    <button type="submit" class="btn btn-primary">Filtrele</button>
                </div>
            </form>
        </aside>

        <section class="col-lg-9" aria-label="Ürünler">
            @if (Model.Products.Items.Count == 0)
            {
                <div class="lh-surface p-5 text-center">
                    <i class="bi bi-search fs-1 text-secondary"></i>
                    <p class="mt-3 mb-1 fw-semibold">Bu filtrelere uygun ürün bulamadık.</p>
                    <a class="text-accent" asp-action="Index">Filtreleri temizle</a>
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-md-3 g-3">
                    @foreach (var product in Model.Products.Items)
                    {
                        <div class="col">
                            <partial name="_ProductCard" model="product" />
                        </div>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <nav class="mt-4 d-flex justify-content-center" aria-label="Sayfalama">
                        <ul class="pagination mb-0">
                            @if (page > 1)
                            {
                                <li class="page-item"><a class="page-link" aria-label="Önceki" asp-action="Index" asp-all-route-data="@((q with { Page = page - 1 }).ToRouteValues())"><i class="bi bi-chevron-left"></i></a></li>
                            }
                            else
                            {
                                <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
                            }

                            @for (var i = firstPage; i <= lastPage; i++)
                            {
                                if (i == page)
                                {
                                    <li class="page-item active" aria-current="page"><span class="page-link">@i</span></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="@((q with { Page = i }).ToRouteValues())">@i</a></li>
                                }
                            }

                            @if (page < totalPages)
                            {
                                <li class="page-item"><a class="page-link" aria-label="Sonraki" asp-action="Index" asp-all-route-data="@((q with { Page = page + 1 }).ToRouteValues())"><i class="bi bi-chevron-right"></i></a></li>
                            }
                            else
                            {
                                <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-right"></i></span></li>
                            }
                        </ul>
                    </nav>
                }
            }
        </section>
    </div>
</div>
