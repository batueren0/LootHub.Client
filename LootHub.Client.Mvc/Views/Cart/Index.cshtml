@model List<CartItem>
@{
    ViewData["Title"] = "Sepetim";
    var itemCount = Model.Sum(x => x.Quantity);
    var total = Model.Sum(x => x.LineTotal);
}

<div class="container py-4">
    <h1 class="h2 mb-4">Sepetim <span class="text-secondary fs-6 fw-normal">@itemCount ürün</span></h1>

    @if (Model.Count == 0)
    {
        <div class="lh-surface p-5 text-center">
            <i class="bi bi-bag fs-1 text-secondary"></i>
            <p class="mt-3 mb-3 fw-semibold">Sepetin şu an boş.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Ürünlere göz at</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="lh-surface">
                    @foreach (var item in Model)
                    {
                        var maxQuantity = Math.Min(10, item.Stock);
                        <div class="d-flex flex-wrap gap-3 align-items-center p-3 border-bottom">
                            <div class="lh-media lh-media-thumb"><img src="@(item.ImageUrl ?? ProductDisplay.CategoryImage(item.CategoryName))" alt=""></div>
                            <div class="flex-grow-1" style="min-width:10rem">
                                <a asp-controller="Shop" asp-action="Product" asp-route-slug="@item.Slug" class="fw-semibold">@item.Name</a>
                                <div class="small text-secondary">@ProductDisplay.Price(item.UnitPrice) / adet</div>
                            </div>
                            <div class="d-flex align-items-center gap-3 ms-auto">
                                @* -/+ butonları formu yeni adetle gönderir: tıklanan butonun name/value'su "quantity" olur *@
                                <form asp-action="Update" method="post" class="input-group input-group-sm" style="width:7.5rem">
                                    <input type="hidden" name="productId" value="@item.ProductId">
                                    <button type="submit" class="btn btn-outline-light" name="quantity" value="@(item.Quantity - 1)" aria-label="Azalt"><i class="bi bi-dash"></i></button>
                                    <span class="form-control text-center" aria-label="Adet">@item.Quantity</span>
                                    <button type="submit" class="btn btn-outline-light" name="quantity" value="@(item.Quantity + 1)" aria-label="Arttır" disabled="@(item.Quantity >= maxQuantity)"><i class="bi bi-plus"></i></button>
                                </form>
                                <span class="lh-price fs-5 text-end" style="min-width:7.5rem">@ProductDisplay.Price(item.LineTotal)</span>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId">
                                    <button type="submit" class="btn btn-ghost" aria-label="Sepetten kaldır"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
                <a asp-controller="Shop" asp-action="Index" class="d-inline-block mt-3 small text-secondary"><i class="bi bi-arrow-left me-1"></i>Alışverişe devam et</a>
            </div>

            <div class="col-lg-4">
                <div class="lh-surface p-4 position-sticky" style="top:8.5rem">
                    <h2 class="h5 mb-3">Sipariş özeti</h2>
                    <div class="d-flex justify-content-between mb-2"><span class="text-secondary">Ara toplam</span><span>@ProductDisplay.Price(total)</span></div>
                    <div class="d-flex justify-content-between mb-3"><span class="text-secondary">Kargo</span><span>Ücretsiz</span></div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center mb-4"><span class="fw-semibold">Toplam</span><span class="lh-price">@ProductDisplay.Price(total)</span></div>
                    @* Faz 5: Checkout *@
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg w-100">Siparişi tamamla</a>
                    <p class="small text-secondary mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Fiyatlar sipariş anında tekrar kontrol edilir.</p>
                </div>
            </div>
        </div>
    }
</div>
