@model IReadOnlyList<AddressResponse>
@{
    ViewData["Title"] = "Adreslerim";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h2 mb-0">Adreslerim</h1>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Yeni adres</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="lh-surface p-5 text-center">
            <i class="bi bi-geo-alt fs-1 text-secondary"></i>
            <p class="mt-3 mb-3 fw-semibold">Henüz kayıtlı adresin yok.</p>
            <a asp-action="Create" class="btn btn-primary">İlk adresini ekle</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var address in Model)
            {
                var icon = address.Title.Trim().ToLowerInvariant() switch
                {
                    "ev" => "bi-house",
                    "iş" or "is" => "bi-briefcase",
                    _ => "bi-geo-alt"
                };
                <div class="col">
                    <div class="lh-surface p-3 h-100 d-flex flex-column">
                        <div class="fw-semibold mb-2"><i class="bi @icon me-2 text-accent"></i>@address.Title</div>
                        <div class="small text-secondary flex-grow-1">@address.Details<br>@address.City / @address.Country</div>
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Edit" asp-route-id="@address.Id" class="btn btn-sm btn-outline-light"><i class="bi bi-pencil me-1"></i>Düzenle</a>
                            <form asp-action="Delete" asp-route-id="@address.Id" method="post" onsubmit="return confirm('Bu adresi silmek istediğine emin misin?');">
                                <button type="submit" class="btn btn-sm btn-ghost"><i class="bi bi-trash me-1"></i>Sil</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
