@model HomeViewModel
@{
    ViewData["Title"] = "Ana sayfa";
}

<div class="container py-4">

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h2 class="h3 mb-0">Kategoriler</h2>
        </div>
        @if (Model.Categories.Count == 0)
        {
            <p class="text-secondary mb-0">Kategoriler şu an yüklenemedi.</p>
        }
        <div class="row row-cols-2 row-cols-lg-4 g-3">
            @foreach (var category in Model.Categories)
            {
                <div class="col">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@category.Id" class="lh-surface lh-cat">
                        <div class="lh-media"><img src="@ProductDisplay.CategoryImage(category.Name)" alt=""></div>
                        <div class="p-3 d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">@category.Name</span>
                            <span class="small text-secondary">Ürünler <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h2 class="h3 mb-0">Yeni gelenler</h2>
            <a asp-controller="Shop" asp-action="Index" class="small text-secondary">Tümünü gör <i class="bi bi-arrow-right"></i></a>
        </div>
        @if (Model.Products.Count == 0)
        {
            <p class="text-secondary mb-0">Ürünler şu an yüklenemedi.</p>
        }
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <partial name="_ProductCard" model="product" />
                </div>
            }
        </div>
    </section>

</div>