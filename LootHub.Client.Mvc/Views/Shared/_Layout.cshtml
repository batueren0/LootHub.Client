@inject LootHub.Client.Mvc.Services.ICartService CartService
@{
    var cartCount = CartService.Count();
}
<!doctype html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | LootHub</title>
    <!-- ===== _Layout: <head> ===== -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="~/css/loothub.css" rel="stylesheet">
</head>
<body>
    <!-- ===== _Layout: DUYURU ŞERİDİ ===== -->
    <div class="lh-topbar text-center py-2 px-3">
        <i class="bi bi-truck me-1"></i>Tüm siparişlerde ücretsiz kargo · <i class="bi bi-shield-lock mx-1"></i>iyzico ile güvenli ödeme
    </div>
    <!-- ===== _Layout: NAVBAR (giriş yapmış) ===== -->
    <header class="lh-navbar sticky-top">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container">
                <a class="navbar-brand me-4" href="index.html">Loot<span>Hub</span></a>
                <form class="lh-search d-none d-lg-flex flex-grow-1 me-auto" role="search" method="get" asp-controller="Shop" asp-action="Index">
                    <div class="input-group">
                        <input class="form-control" type="search" name="search" placeholder="Mouse, klavye, kulaklık ara..." aria-label="Ürün ara">
                        <button class="btn" type="submit" aria-label="Ara"><i class="bi bi-search"></i></button>
                    </div>
                </form>
                <div class="d-flex align-items-center gap-1 ms-auto ms-lg-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="lh-icon-btn d-inline-flex align-items-center gap-2 text-decoration-none" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person"></i><span class="d-none d-md-inline fs-6">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Siparişlerim</a></li>
                                <li><a class="dropdown-item" asp-controller="Addresses" asp-action="Index"><i class="bi bi-geo-alt me-2"></i>Adreslerim</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-speedometer2 me-2"></i>Yönetim paneli</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Giriş yap</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Kayıt ol</a>
                    }
                    <a class="lh-icon-btn" asp-controller="Cart" asp-action="Index" aria-label="Sepet, @cartCount ürün"><i class="bi bi-bag"></i>@if (cartCount > 0) { <span class="badge rounded-pill">@cartCount</span> }</a>
                </div>
            </div>
        </nav>
        <!-- Kategori çubuğu: GET /api/categories -->
        <div class="lh-catbar">
            <div class="container d-flex gap-4 overflow-auto">
                @await Component.InvokeAsync("CategoryMenu")
                <a class="d-lg-none ms-auto py-1" asp-controller="Shop" asp-action="Index" aria-label="Ara"><i class="bi bi-search"></i></a>
            </div>
        </div>
    </header>

    <main>
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show mb-0" role="status">
                    <i class="bi bi-check-circle me-2"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>


<!-- ===== _Layout: FOOTER ===== -->
<footer class="lh-footer mt-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="lh-display fs-3 text-white">Loot<span class="text-accent">Hub</span></div>
                <p class="mt-2 mb-0">Oyuncular için mouse, klavye, kulaklık ve monitör.</p>
            </div>
            <div class="col-6 col-lg-2">
                <h3>Alışveriş</h3>
                <ul class="list-unstyled d-grid gap-2 mb-0"><li><a href="products.html">Tüm ürünler</a></li><li><a href="products.html">Mouse</a></li><li><a href="products.html">Klavye</a></li></ul>
            </div>
            <div class="col-6 col-lg-2">
                <h3>Hesabım</h3>
                <ul class="list-unstyled d-grid gap-2 mb-0"><li><a href="orders.html">Siparişlerim</a></li><li><a href="addresses.html">Adreslerim</a></li><li><a asp-controller="Cart" asp-action="Index">Sepetim</a></li></ul>
            </div>
            <div class="col-lg-4">
                <h3>Güvenli ödeme</h3>
                <p class="mb-0"><i class="bi bi-shield-lock me-1"></i>Ödemeler iyzico üzerinden alınır, kart bilgilerin LootHub'a ulaşmaz.</p>
            </div>
        </div>
        <hr class="my-4">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-2 small">
            <span>© 2026 LootHub · Infotech bitirme projesi</span>
            <a href="https://github.com/batueren0"><i class="bi bi-github me-1"></i>GitHub</a>
        </div>
    </div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
